DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Área do cliente: o painel só abre por painel.php (que confere o login).
# O arquivo .html do painel e os arquivos internos de autenticação não podem ser abertos direto.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^painel-cliente\.html$ - [F,L]
RewriteRule ^assets/php/(users|auth|ratelimit)\.php$ - [F,L]
# Contadores do limite de tentativas (gravados pelo PHP, nunca abertos pelo navegador).
RewriteRule ^assets/php/data(/|$) - [F,L]

# Blog: /blog e /blog/ (pasta sem index) redirecionam para a página do blog.
RewriteRule ^blog/?$ /blog.html [R=301,L]
</IfModule>

# Landing page de provedores: o config.js pode ser editado direto no servidor,
# então o navegador sempre confere se há versão nova (sem cache de 7 dias).
<IfModule mod_headers.c>
<FilesMatch "^config\.js$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>

# Cabeçalhos de segurança.
# HSTS sem includeSubDomains: outros subdomínios da .crew podem ser criados sem HTTPS.
# Nenhuma página do site precisa ser aberta dentro de outro site (SAMEORIGIN).
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
